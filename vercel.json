{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ]
    },
    "backend": { "root": "backend", "framework": "fastapi", "entrypoint": "index:app" }
  },
  "rewrites": [
    { "source": "/api/network", "destination": { "service": "app" } },
    { "source": "/api/download/android", "destination": { "service": "app" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
