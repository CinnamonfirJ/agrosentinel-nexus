# SERVER ONLY. Never use NEXT_PUBLIC_ or EXPO_PUBLIC_ for secrets.
# Paste the Neon Postgres connection URI from your project Connect dialog.
# Example shape: postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Private Neon Object Storage on the same branch.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AGRO_CAPTURE_BUCKET=agrosentinel-captures

# Nebius Token Factory and Tavily. No substitute inference/search providers.
NEBIUS_API_KEY=
NEBIUS_ENDPOINT=https://api.tokenfactory.nebius.com/v1
# Exact model IDs available to your Nebius account (vision must accept images).
VISION_MODEL=
REASONING_MODEL=
TAVILY_API_KEY=

# Optional for managed deployments: retain the same Fernet key across restarts.
# If blank, backend/data/vault.key is generated and must be backed up.
# AGRO_VAULT_KEY=
